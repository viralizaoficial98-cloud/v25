# ─── Frontend (públicas — embutidas no build) ───────────────────────────────
# URL do projecto Supabase (Project Settings → API)
VITE_SUPABASE_URL=
# Chave "anon"/"publishable" (pública, protegida por RLS). NUNCA usar a service_role aqui.
VITE_SUPABASE_ANON_KEY=
# URL pública do site (SEO, links nos emails). Ex.: https://v25.vibes.ao
VITE_SITE_URL=
# Subpasta de instalação no cPanel (ex.: /v25/). Por omissão: /
VITE_BASE_PATH=/
