# ─── Frontend (build Vite) — NUNCA colocar aqui credenciais ─────────────────
# Tudo o que começa por VITE_ fica público dentro do JavaScript compilado.
# As credenciais MySQL/SMTP ficam APENAS em backend/app/.env (servidor, fora de public_html).

# URL pública do site (meta tags Open Graph)
VITE_SITE_URL=https://renewangola.online
# Subpasta de instalação (ex.: /v25/). Por omissão: /
VITE_BASE_PATH=/
# Opcional: endereço da API (por omissão <base>/api, na mesma origem)
# VITE_API_BASE=/api
# Opcional: URL dos ficheiros carregados no painel (por omissão <base>/uploads/media)
# VITE_MEDIA_URL=/uploads/media

# Apenas desenvolvimento: servidor PHP local para onde o Vite encaminha /api
# V25_API_PROXY=http://127.0.0.1:8080
