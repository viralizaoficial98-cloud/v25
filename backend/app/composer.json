{
  "name": "vibes/v25-api",
  "description": "API PHP do V25 — O Legado (MySQL/MariaDB, cPanel)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "phpmailer/phpmailer": "^6.9",
    "chillerlan/php-qrcode": "^5.0",
    "setasign/fpdf": "^1.8"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "config": { "optimize-autoloader": true, "sort-packages": true, "platform": { "php": "8.1.0" } }
}
