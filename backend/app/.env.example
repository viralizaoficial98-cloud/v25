# =============================================================================
# V25 — O LEGADO · configuração PRIVADA da API (copiar para .env e preencher)
# Este ficheiro fica em /home/renewangola/v25_app/.env — FORA de public_html.
# Nunca colocar credenciais no código nem em variáveis VITE_.
# =============================================================================

APP_ENV=production
APP_URL=https://renewangola.online
# Gere com: php bin/generate-key.php   (64 caracteres hex). NÃO altere depois de emitir ingressos:
# a assinatura dos QR Codes depende desta chave.
APP_KEY=

# ── Base de dados MySQL (cPanel → Bases de dados MySQL) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=renewangola_v25
DB_USERNAME=CONFIGURAR
DB_PASSWORD=CONFIGURAR

# ── Sessões do painel ───────────────────────────────────────────────────────
SESSION_NAME=v25_sess
# auto = cookie Secure quando o pedido chega por HTTPS (recomendado). true após activar SSL.
SESSION_SECURE=auto
SESSION_LIFETIME_MINUTES=120

# ── Primeira instalação: token para criar o 1.º administrador em /admin ──────
# Depois de criado, pode apagar esta linha (a função desactiva-se sozinha).
SETUP_TOKEN=

# ── SMTP (cPanel → Contas de Email → Connect Devices) ───────────────────────
SMTP_HOST=mail.renewangola.online
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="V25 — O Legado"

# ── Ficheiros ───────────────────────────────────────────────────────────────
# Comprovativos e logs (privado). Por omissão: <esta pasta>/storage
# STORAGE_PATH=/home/renewangola/v25_app/storage
# Galeria pública (fotografias/vídeos carregados no painel)
MEDIA_PATH=/home/renewangola/public_html/uploads/media
MEDIA_URL=/uploads/media

# true apenas se o site estiver atrás de Cloudflare/proxy de confiança
TRUST_PROXY_HEADERS=false
