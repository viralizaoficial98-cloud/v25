# public_html/api — encaminha todos os pedidos /api/* para index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
# Ficheiros de configuração (.user.ini, .htaccess…) nunca são servidos
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
# Opcional — caminho da pasta privada, se não for ../../v25_app (ex.: /home/renewangola/v25_app):
# SetEnv V25_APP_DIR /home/renewangola/v25_app
