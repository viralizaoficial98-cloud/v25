# public_html/uploads — fotografias e vídeos carregados no painel.
# Nenhum script pode ser executado nesta pasta (defesa contra uploads maliciosos).
Options -Indexes -ExecCGI
<FilesMatch "\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|shtml|asp|aspx|jsp|html?|svg|js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; sandbox"
  Header set Cache-Control "public, max-age=2592000"
</IfModule>
