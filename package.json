{
  "name": "v25-o-legado",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "V25 — O Legado · Plataforma oficial do evento de 25 anos do Vibes – Grupo Vocal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "images": "node scripts/optimize-images.mjs",
    "test:api": "node scripts/test-api.mjs",
    "build:schema": "node scripts/build-mysql-schema.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "api:dev": "php -S 127.0.0.1:8080 backend/tests/router.php",
    "build:deploy": "node scripts/build-deploy.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.11.14",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "mysql2": "^3.24.6",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
